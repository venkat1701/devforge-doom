{
  "algo": "ppo",
  "seed": 0,
  "total_steps": 20000000,
  "num_envs": 32,
  "episode_ticks": [2100, 4200],
  "fast_env": false,
  "torch_threads": 1,
  "purpose": "experimental-memory-bc-rnd-not-promoted",
  "reward": "official-wrapper",
  "model": {
    "hidden": 512,
    "embed": 512,
    "use_map": false,
    "use_episodic": false,
    "use_pixels": true,
    "aux": false,
    "memory_slots": 16,
    "memory_dim": 64
  },
  "asymmetric_critic": true,
  "ppo": {
    "lr": 0.00025,
    "anneal_lr": true,
    "num_steps": 128,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "num_minibatches": 4,
    "update_epochs": 4,
    "norm_adv": true,
    "clip_coef": 0.1,
    "clip_vloss": true,
    "ent_coef": 0.01,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "critic_warmup_updates": 10
  },
  "rnd": {
    "coefficient": 0.01,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "learning_rate": 0.0001,
    "feature_dim": 128,
    "batch_size": 256,
    "epochs": 1,
    "observation_clip": 5.0,
    "variance_floor": 0.0001,
    "max_grad_norm": 0.5,
    "value_coef": 0.5
  },
  "save_every_updates": 50
}
